{
  "name": "izmir-open-data-js",
  "version": "2.2.0",
  "description": "Izmir Open Data API wrapper - İzmir Büyükşehir Belediyesi Açık Veri API'leri için TypeScript/JavaScript kütüphanesi",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "izmir",
    "api",
    "open-data",
    "turkey",
    "municipality",
    "typescript",
    "eshot",
    "izban",
    "metro",
    "ckan",
    "otopark"
  ],
  "author": "Ata Can Yaymacı <atacanymc@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "izmir-mcp": "./dist/mcp/index.js",
    "izmir-cli": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtaCanYmc/izmir-open-data-js.git"
  },
  "homepage": "https://github.com/AtaCanYmc/izmir-open-data-js#readme",
  "bugs": {
    "url": "https://github.com/AtaCanYmc/izmir-open-data-js/issues"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/fetch-jsonp": "^1.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/expect": "^5.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}'",
    "lint:fix": "eslint 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}' --fix",
    "format": "prettier --write 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}'",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:watch": "vitest --exclude 'tests/integration/**'",
    "test:coverage": "vitest run --coverage --exclude 'tests/integration/**'",
    "test:live": "LIVE_API_TESTS=1 vitest run tests/integration/",
    "test:all": "LIVE_API_TESTS=1 vitest run",
    "site:build": "node scripts/build-site.js",
    "site:serve": "python3 -m http.server 8080 --directory site",
    "docs:build": "npm run site:build",
    "docs:serve": "npm run site:serve",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fetch-jsonp": "^1.4.0",
    "picocolors": "^1.1.1"
  }
}
